# Veil8004 environment. Copy to .env and fill in. Never commit .env.
# Everything below runs locally on Anvil without a CRE account.

# ---- Chains -----------------------------------------------------------------
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
# CRE chain-name / chain selector for Monad testnet (from @chainlink/cre-sdk 1.23.0)
CRE_CHAIN_NAME=monad-testnet
CRE_CHAIN_SELECTOR=2183018362218727504

# ---- Keys (Anvil default keys are fine locally; use fresh keys on testnet) --
DEPLOYER_PRIVATE_KEY=
# Used by `cre workflow simulate --broadcast` and `cre workflow deploy`
CRE_ETH_PRIVATE_KEY=

# ---- ERC-8004 on Monad testnet (verified on-chain 2026-10-08, version 2.0.0) --
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Canonical testnet Validation Registry exists at 0x8004Cb1BF31DAf7788923b405b754f57acEB4272
# but the spec deploys its own behind an adapter. See docs/phase0.md (Q5). Leave empty to deploy.
VALIDATION_REGISTRY=

# ---- CRE --------------------------------------------------------------------
# OPEN: take from the CRE Forwarder Directory for monad-testnet (docs/phase0.md Q1).
# Locally, Deploy.s.sol uses the MockForwarder instead.
CRE_FORWARDER_ADDRESS=
# Set after `cre workflow deploy`; consumers pin these via setExpectedWorkflowId.
W1_WORKFLOW_ID=
W2_WORKFLOW_ID=
W3_WORKFLOW_ID=
CRE_WORKFLOW_OWNER=

# ---- Workflow keys (X25519, base64). On CRE these are secrets, not env. -----
W1_PUBLIC_KEY=
W1_DECRYPT_KEY=
W3_PUBLIC_KEY=
W3_DECRYPT_KEY=

# ---- Services -----------------------------------------------------------------
SEALED_STORE_URL=http://127.0.0.1:8787
SEALED_STORE_W1_TOKEN=
SEALED_STORE_W3_TOKEN=
MOCK_SCREENING_URL=http://127.0.0.1:8788
SCREENING_API_KEY=

# ---- Local DON simulation (Anvil only) ---------------------------------------------
# Key the local runner delivers reports with; Deploy.s.sol allow-lists its address on the MockForwarder.
# Empty = Anvil default account 8 (LOCAL_DON_ADDRESS overrides the allow-listed address in Deploy.s.sol).
LOCAL_DON_PRIVATE_KEY=
LOCAL_DON_ADDRESS=

# ---- Protocol parameters -------------------------------------------------------
EPOCH_LENGTH_SECONDS=3600
# Validity window of the demo SANCTIONS_SCREEN_V1 policy, in seconds.
POLICY_VALIDITY_SECONDS=3600
# Whose SANCTIONS_SCREEN_V1 results unlock TreasuryAction. Empty on Anvil = default account 7; required elsewhere.
TREASURY_OPERATOR=
